# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
# B2_REGION=<your-region>            # e.g. the region segment of the endpoint
# B2_APPLICATION_KEY_ID=<your-keyID-from-the-B2-dashboard>
# B2_APPLICATION_KEY=<your-applicationKey-shown-once-on-creation>
# B2_BUCKET_NAME=my-audiobooks

# Optional: public base URL if your bucket is served publicly (otherwise leave blank
# and the app uses short-lived presigned URLs for every read).
# B2_PUBLIC_URL=

# Text-to-speech (required to generate narration; not needed just to browse)
# TTS_PROVIDER selects the narration adapter. Default is "openai".
TTS_PROVIDER=openai
# API key for the active provider. For the default provider this is your OpenAI key.
OPENAI_API_KEY=your_openai_api_key
# Optional alternate provider. Set TTS_PROVIDER=elevenlabs and `pip install elevenlabs`
# to use it; then provide:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Default narrator voice id (provider-specific). Leave blank to use the provider default.
TTS_DEFAULT_VOICE=
